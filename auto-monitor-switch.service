[Unit]
Description=KDE Plasma Auto Switch Internal and External Displays
PartOf=graphical-session.target
After=graphical-session.target plasma-kscreen.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/bin/auto-monitor-switch.py
Restart=always
RestartSec=3

[Install]
WantedBy=graphical-session.target
